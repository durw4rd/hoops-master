  "views": {
    "public.player_credit_balances": {
      "columns": {
        "group_id": {
          "name": "group_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "user_id": {
          "name": "user_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "email": {
          "name": "email",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "display_name": {
          "name": "display_name",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "total_paid": {
          "name": "total_paid",
          "type": "numeric(10, 2)",
          "primaryKey": false,
          "notNull": true
        },
        "total_spent": {
          "name": "total_spent",
          "type": "numeric(10, 2)",
          "primaryKey": false,
          "notNull": true
        },
        "total_earned": {
          "name": "total_earned",
          "type": "numeric(10, 2)",
          "primaryKey": false,
          "notNull": true
        },
        "balance": {
          "name": "balance",
          "type": "numeric(10, 2)",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT\n    gm.group_id,\n    gm.user_id,\n    u.email,\n    u.display_name,\n    COALESCE(p.total_paid, 0)    AS total_paid,\n    COALESCE(t_spent.total_spent, 0)  AS total_spent,\n    COALESCE(t_earned.total_earned, 0) AS total_earned,\n    COALESCE(p.total_paid, 0)\n      - COALESCE(t_spent.total_spent, 0)\n      + COALESCE(t_earned.total_earned, 0) AS balance\n  FROM group_members gm\n  JOIN users u ON u.id = gm.user_id\n  LEFT JOIN (\n    SELECT group_id, user_id, SUM(amount) AS total_paid\n    FROM payments GROUP BY group_id, user_id\n  ) p ON p.group_id = gm.group_id AND p.user_id = gm.user_id\n  LEFT JOIN (\n    SELECT group_id, to_user_id AS user_id, SUM(amount) AS total_spent\n    FROM spot_transactions\n    GROUP BY group_id, to_user_id\n  ) t_spent ON t_spent.group_id = gm.group_id AND t_spent.user_id = gm.user_id\n  LEFT JOIN (\n    SELECT group_id, from_user_id AS user_id, SUM(amount) AS total_earned\n    FROM spot_transactions\n    WHERE from_user_id IS NOT NULL\n    GROUP BY group_id, from_user_id\n  ) t_earned ON t_earned.group_id = gm.group_id AND t_earned.user_id = gm.user_id\n  WHERE gm.status = 'active'\n",
      "name": "player_credit_balances",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
